<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A namespace segment "Android" would shadow the global Android.* namespaces, so the root
         namespace is Chess.Droid even though the assembly is the Android chess head. -->
    <RootNamespace>Chess.Droid</RootNamespace>
    <ApplicationId>org.sebgod.chess</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Android head. Like Chess.Web, it lives OUTSIDE Chess.sln, so that a solution build (and the
         `test` CI job) doesn't drag in the android workload + JDK + Android SDK. It is not
         ungated for that, though: the `android` job in .github/workflows/dotnet-desktop.yml
         compiles it on every push and PR. Packaging a signed APK is still a local step. -->
  </PropertyGroup>

  <!-- Pin a coherent SDL managed+native pair for android, overriding the repo's 3.5.0-preview CPM
       pin for this head only.

       3.4.16 rather than 3.4.10.5 because Google Play refuses a bundle whose native libraries are
       not 16 KB page aligned, and 3.4.10.5's libSDL3.so was the ONLY library in the whole .aab that
       wasn't — every .so the .NET Android SDK emits is already aligned. That is warning XA0141, and
       it is a Play submission blocker rather than advice. 3.4.16's arm64-v8a and x86_64 builds are
       16 KB aligned; its armeabi-v7a and x86 ones still are not, which does not matter here: a
       Release build ships only the two 64-bit ABIs, and 16 KB pages are a 64-bit concern.

       THE PAIR MUST STAY COHERENT: SDL compares its Java and native versions at startup and aborts
       on a mismatch. 3.4.12.x is the version that got this wrong — Java 3.4.10 against native
       3.4.12 — and is still the one to avoid. Coherence is checkable from the packages alone, with
       no device: javap -p -constants on org/libsdl/app/SDLActivity.class inside the .aar gives
       SDL_MAJOR/MINOR/MICRO_VERSION, and the version string in
       runtimes/android-arm64/native/libSDL3.so gives the native side. 3.4.16 reads 3.4.16 against
       "SDL-3.4.16-release-3.4.16". -->
  <ItemGroup>
    <PackageReference Include="SDL3-CS" VersionOverride="3.4.16" />
    <PackageReference Include="SDL3-CS.Android" VersionOverride="3.4.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chess.Lib\Chess.Lib.csproj" />
    <ProjectReference Include="..\Chess.UCI\Chess.UCI.csproj" />
    <ProjectReference Include="..\Chess.Net\Chess.Net.csproj" />
  </ItemGroup>

  <!-- Bundle the glyph fonts as APK assets (assets/Fonts/*.ttf); MainActivity.StageFonts copies
       them to FontPaths.FontsDirectory at startup so PixelGameDisplay's rasterizer finds them. -->
  <ItemGroup>
    <AndroidAsset Include="..\Chess.Lib\Fonts\DejaVuSans.ttf" Link="Assets\Fonts\DejaVuSans.ttf" />
    <AndroidAsset Include="..\Chess.Lib\Fonts\Merida.ttf" Link="Assets\Fonts\Merida.ttf" />
  </ItemGroup>

  <!-- The cloud backend's config, bundled as an asset so MainActivity can read it at startup. Absent
       from the repository on purpose, exactly as Chess.Web/wwwroot/firebase-config.json is: it names
       a live project, and a fork must not inherit a pointer at somebody else's database. A build
       without it matches this glob nothing and simply never offers "Online game" — which is the
       normal state of every fork and PR build. CI writes it from the FIREBASE_CONFIG secret. -->
  <ItemGroup>
    <AndroidAsset Include="firebase-config.json" Link="Assets\firebase-config.json" Condition="Exists('firebase-config.json')" />
  </ItemGroup>

  <!-- Renderer + DIR.Lib: sibling working copies for local iteration, NuGet otherwise (mirrors
       Chess.GUI). The renderer must be the multi-targeted build carrying the net10.0-android TFM. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
    <ProjectReference Include="..\..\SdlVulkan.Renderer\src\SdlVulkan.Renderer\SdlVulkan.Renderer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="DIR.Lib" />
    <PackageReference Include="SdlVulkan.Renderer" />
  </ItemGroup>

</Project>
