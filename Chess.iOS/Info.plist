<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundle id, version and display name come from Chess.iOS.csproj (ApplicationId,
	     ApplicationDisplayVersion, ApplicationTitle); the minimum OS from SupportedOSPlatformVersion. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<!-- Without a launch screen iOS runs the app letterboxed at a legacy size. An empty dictionary is
	     a plain launch screen in the system background, which SDL's first frame replaces. -->
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Every orientation: across-the-table play lays the iPad flat, and the board relayouts on rotation. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Full screen only: no Split View or Stage Manager window, so the surface is the screen. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- Documents/chess.log shows in the Files app (On My iPad > Chess), for sending a run's log. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Asked once, the first time the LAN lobby opens a socket on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Chess looks for other players on your network for a LAN game.</string>
</dict>
</plist>
