<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The iOS SDK pinned to 26.0, which needs Xcode 26.0: the newest .NET for iOS (27.2) wants Xcode
         27.2, which GitHub's macOS runners offer only as a preview image, and the workload accepts only
         26.0 and 27.2 here (26.5 is NETSDK1140). The `ios` job selects Xcode 26.0 to match. Move both
         together once a stable runner carries Xcode 27. The SDK version is what the app is BUILT with;
         the oldest iPadOS it runs on is SupportedOSPlatformVersion below. -->
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <!-- MoltenVK's iOS slice needs 15, and iPadOS 15 is what any iPad Pro still in use can run. -->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Chess.iOS</RootNamespace>
    <ApplicationTitle>Chess</ApplicationTitle>
    <ApplicationId>org.sebgod.chess</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- The iPad head. Like Chess.Droid it lives OUTSIDE Chess.sln, so a solution build needs no iOS
         workload (which exists only on macOS anyway). The `ios` job in .github/workflows/dotnet-desktop.yml
         builds it on a macOS runner into an UNSIGNED .ipa, which AltStore or SideStore signs with the
         installer's own free Apple ID: no certificate, team or provisioning profile is involved here.
         See docs/ios.md. -->
  </PropertyGroup>

  <!-- SDL's managed bindings are NOT pinned to the native framework's version here, unlike Chess.Droid:
       the native is the renderer's choice (SDL 3.4.16), and its package's iOS targets say why the 3.5
       preview bindings are safe with it. -->

  <!-- The game itself is Chess.Touch, shared with Chess.Droid. -->
  <ItemGroup>
    <ProjectReference Include="..\Chess.Touch\Chess.Touch.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
    <ProjectReference Include="..\..\SdlVulkan.Renderer\src\SdlVulkan.Renderer\SdlVulkan.Renderer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="DIR.Lib" />
    <PackageReference Include="SdlVulkan.Renderer" />
    <PackageReference Include="SharpAstro.AppShell" />
  </ItemGroup>

  <!-- iOS has no Vulkan and SDL3-CS has no iOS natives, so the app carries both as DYNAMIC frameworks
       (SDL3.xcframework, MoltenVK.xcframework). SdlVulkan.Renderer's package adds them (its
       buildTransitive targets fetch the pinned releases on the first build, macOS only) and the build
       copies each into Chess.iOS.app/Frameworks/, where the renderer's AppleVulkan loads them. Built
       against the sibling source there is no package to bring the targets, so they are imported here. -->
  <Import Project="..\..\SdlVulkan.Renderer\src\SdlVulkan.Renderer\buildTransitive\SdlVulkan.Renderer.targets"
          Condition="'$(UseLocalSiblings)' == 'true' And Exists('..\..\SdlVulkan.Renderer\src\SdlVulkan.Renderer\buildTransitive\SdlVulkan.Renderer.targets')" />

  <!-- The fonts, at the path FontPaths looks in (AppContext.BaseDirectory/Fonts, the bundle's root on
       iOS). The bundle is read-only and these are in it from the install, so nothing is staged at
       startup the way Chess.Droid copies its APK assets out. -->
  <ItemGroup>
    <BundleResource Include="..\Chess.Lib\Fonts\DejaVuSans.ttf" LogicalName="Fonts/DejaVuSans.ttf" />
    <BundleResource Include="..\Chess.Lib\Fonts\Merida.ttf" LogicalName="Fonts/Merida.ttf" />
  </ItemGroup>

  <!-- The home-screen icon, as loose PNGs at the bundle root that Info.plist's CFBundleIcons names,
       NOT an asset catalog: Xcode 26's actool will not compile one without an iOS SIMULATOR runtime
       matching the SDK (26.0, 23A339), which the macOS runner does not carry ("No simulator runtime
       version ... available to use with iphonesimulator SDK version 23A339"). Loose icons are the
       pre-catalog way, still honoured; only the App Store insists on a catalog, and this app is
       sideloaded. The names are the ones actool itself would emit. It is the white knight on a
       checkerboard that Chess.GUI, Chess.Droid and the web favicon use, drawn at each size by DIR.Lib's
       RenderChess_WhiteKnightOnCheckerboard recipe, opaque RGB because an iOS icon may carry no alpha. -->
  <ItemGroup>
    <BundleResource Include="Icons\AppIcon60x60@2x.png" LogicalName="AppIcon60x60@2x.png" />
    <BundleResource Include="Icons\AppIcon76x76@2x~ipad.png" LogicalName="AppIcon76x76@2x~ipad.png" />
    <BundleResource Include="Icons\AppIcon83.5x83.5@2x~ipad.png" LogicalName="AppIcon83.5x83.5@2x~ipad.png" />
  </ItemGroup>

  <!-- The cloud backend's config, exactly as Chess.Droid takes it: absent from the repository, written
       by CI from the FIREBASE_CONFIG secret, and a build without it simply never offers "Online game". A
       local build takes your own copy outside the checkout when there is no project copy (ChessCloudConfig
       in Directory.Build.props). -->
  <ItemGroup>
    <BundleResource Include="$(ChessCloudConfig)" LogicalName="firebase-config.json" Condition="'$(ChessCloudConfig)' != ''" />
  </ItemGroup>

</Project>
