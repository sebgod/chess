<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Chess.UCI (-> Chess.Lib -> DIR.Lib) gives us UciMove.Format/Parse + FormatMoves and the
       Chess.Lib.UI player interfaces the network players implement. Sockets come from the BCL
       (System.Net.Sockets), available on desktop AND net10.0-android, so no extra packages. -->
  <ItemGroup>
    <ProjectReference Include="..\Chess.UCI\Chess.UCI.csproj" />
  </ItemGroup>

  <!-- LAN.Lib: peer discovery (the UDP beacon + peer table this project used to own, extracted and
       generalised into its own repo). Chess keeps only the TCP session channel on top of it and
       announces as service "chess". -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\LAN.Lib\src\LAN.Lib\LAN.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="LAN.Lib" />
  </ItemGroup>

</Project>
