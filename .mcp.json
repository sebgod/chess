{
  "mcpServers": {
    "chess": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["run", "--project", "Chess.MCP", "-c", "Release"]
    },
    "tui-inspector": {
      "type": "stdio",
      "command": "dnx",
      "args": ["Console.Lib.Inspector", "--yes"]
    },
    "gui-inspector": {
      "type": "stdio",
      "command": "dnx",
      "args": ["SdlVulkan.Renderer.Inspector", "--yes"]
    }
  }
}
