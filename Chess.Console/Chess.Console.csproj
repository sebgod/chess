<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BenchmarkSuite1" />
    <InternalsVisibleTo Include="Chess.Console.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chess.Lib\Chess.Lib.csproj" />
    <ProjectReference Include="..\Chess.UCI\Chess.UCI.csproj" />
    <ProjectReference Include="..\Chess.Net\Chess.Net.csproj" />
    <ProjectReference Include="..\Chess.Engine\Chess.Engine.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="Console.Lib" />
    <PackageReference Include="DIR.Lib" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\Console.Lib\src\Console.Lib\Console.Lib.csproj" />
    <ProjectReference Include="..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>

  <Target Name="CopyEngineExecutable" AfterTargets="Build">
    <ItemGroup>
      <EngineFiles Include="..\Chess.Engine\bin\$(Configuration)\$(TargetFramework)\chess-engine.*" />
    </ItemGroup>
    <Copy SourceFiles="@(EngineFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishEngineNative" AfterTargets="Publish">
    <PropertyGroup>
      <_EnginePublishDir>$(IntermediateOutputPath)engine-publish/</_EnginePublishDir>
      <_EngineRidArg Condition="'$(RuntimeIdentifier)' != ''"> -r $(RuntimeIdentifier)</_EngineRidArg>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)../Chess.Engine/Chess.Engine.csproj&quot; -c $(Configuration)$(_EngineRidArg) -p:PublishAot=$(PublishAot) -o &quot;$(_EnginePublishDir.TrimEnd('/'))&quot;" />
    <ItemGroup>
      <EnginePublishFiles Include="$(_EnginePublishDir)chess-engine*" />
    </ItemGroup>
    <Copy SourceFiles="@(EnginePublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>


  <!--
    The debug inspector lives in Console.Lib / DIR.Lib behind #if DEBUG, so it exists only in a DEBUG build
    of those libraries. A PUBLISHED package is built in Release, which means its inspector is compiled out
    and this project cannot reference it at all. So the wiring is gated on having the siblings as PROJECT
    references in a Debug build, which is the same rule Chess.GUI's SDL inspector lives by.

    Locally that is the default (UseLocalSiblings auto-detects the sibling checkouts). CI restores packages,
    so CONSOLE_INSPECTOR is undefined there and the inspector code simply is not compiled.
  -->
  <PropertyGroup Condition="'$(UseLocalSiblings)' == 'true' AND '$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);CONSOLE_INSPECTOR</DefineConstants>
  </PropertyGroup>

</Project>
