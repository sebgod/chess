{
  "rules": {
    ".read": false,
    ".write": false,

    "players": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "$other": { ".validate": false }
      }
    },

    "open": {
      ".read": "auth != null",

      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['gameId', 'name', 'color', 'updated'])",

        "gameId":  { ".validate": "newData.isString() && newData.val().length <= 64" },
        "name":    { ".validate": "newData.isString() && newData.val().length <= 32" },
        "color":   { ".validate": "newData.isString() && (newData.val() === 'w' || newData.val() === 'b')" },
        "updated": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other":  { ".validate": false }
      }
    },

    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",

        "$from": {
          ".read":  "auth != null && auth.uid === $from",
          ".write": "auth != null && auth.uid === $from",
          ".validate": "!newData.exists() || newData.hasChildren(['gameId', 'name', 'color'])",

          "gameId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "name":   { ".validate": "newData.isString() && newData.val().length <= 32" },
          "color":  { ".validate": "newData.isString() && (newData.val() === 'w' || newData.val() === 'b')" },

          "declined": {
            ".write": "auth != null && auth.uid === $to && data.parent().exists()",
            ".validate": "newData.isBoolean()"
          },

          "$other": { ".validate": false }
        }
      }
    },

    "games": {
      "$gameId": {
        ".read": "auth != null && (data.child('w/uid').val() === auth.uid || data.child('b/uid').val() === auth.uid)",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['g', 'n'])",
        "g": {
          ".write": "auth != null && (data.parent().child('w/uid').val() === auth.uid || data.parent().child('b/uid').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 24576 && (!data.exists() || newData.val().beginsWith(data.val())) && (!data.parent().exists() || (newData.parent().child('n').val() === data.parent().child('n').val() + 1 && ((data.parent().child('n').val() % 2 === 0 && auth.uid === data.parent().child('w/uid').val()) || (data.parent().child('n').val() % 2 === 1 && auth.uid === data.parent().child('b/uid').val()))))"
        },
        "n": {
          ".write": "auth != null && (data.parent().child('w/uid').val() === auth.uid || data.parent().child('b/uid').val() === auth.uid)",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.parent().exists() || (newData.val() === data.parent().child('n').val() + 1 && newData.parent().child('g').val().length > data.parent().child('g').val().length))"
        },
        "w": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['uid'])",
          "uid":  { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "$other": { ".validate": false }
        },

        "b": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['uid'])",
          "uid":  { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "$other": { ".validate": false }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
