@page "/"
@using System.Collections.Immutable
@using Chess.Lib
@using Chess.Lib.UI
@using DIR.Lib
@using WebGl.Renderer
@using Chess.UCI
@using Microsoft.AspNetCore.Components.Routing
@using Action = Chess.Lib.Action
@implements IDisposable
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Chess — Blazor/WASM</PageTitle>

@* Titlebar, toolbar, board — the desktop window's own chrome, in a fixed full-viewport column (see
   app.css). Nothing lives below the board, because nothing scrolls: the two explainers open over it
   from the chips up here. Which renderer is live, and how any of this is built, is not what someone
   who came to play needs read out to them first. *@
<div class="app">
    <div class="titlebar">
        <span class="title">Chess</span>
        <span class="tagline">
            Play the computer, someone sitting beside you, or anyone in the world by link.
        </span>
        <span class="spacer"></span>

        @* Visible only while loading; once the canvas is live the status renders in the display's
           own status bar (in-canvas, like the desktop GUI). Post-ready it goes sr-only — screen
           readers keep the live announcements, and no chrome moves when the text changes. *@
        <span class="status @(_ready ? "sr-only" : null)" aria-live="polite">@_status</span>

        <button class="chip @(_panel == Panel.LinkPlay ? "active" : null)"
                @onclick="() => TogglePanel(Panel.LinkPlay)">Play by link</button>
        <button class="chip @(_panel == Panel.UnderTheHood ? "active" : null)"
                @onclick="() => TogglePanel(Panel.UnderTheHood)">Under the hood</button>
    </div>

    @if (_screen == Screen.Setup)
    {
        <div class="toolbar">
            <button class="new" @onclick="FinishSetupAsync" disabled="@_busy">▶ Start game</button>
            <button @onclick="BackToMenuAsync" disabled="@_busy">↩ Menu</button>
        </div>
    }
    else if (_screen == Screen.Playing)
    {
        <div class="toolbar">
            <button class="new" @onclick="BackToMenuAsync" disabled="@_busy">↻ New game</button>
            @if (_vsComputer)
            {
                @* The wizard sets the starting level; this keeps the browser's ability to change it
                   mid-game, which the other front-ends have no equivalent of. *@
                <label>Difficulty
                    <select @onchange="OnDifficultyChanged" disabled="@_busy">
                        @foreach (var level in DifficultyExtensions.All)
                        {
                            <option value="@level" selected="@(_difficulty == level)">@level.ToLabel()</option>
                        }
                    </select>
                </label>
            }
            @if (ShowShareRow)
            {
                @* Correspondence handoff — all serverless: the link IS the game. Copy is the
                   universal path; mailto needs no JS at all; the native share sheet appears
                   only where the browser supports it (mostly mobile — straight to WhatsApp). *@
                <button class="share copy @(_linkCopied ? "copied" : null)" @onclick="CopyLinkAsync" disabled="@_busy">
                    @(_linkCopied ? "Copied ✓" : "📋 Copy link")
                </button>
                <a class="share mail" href="@MailtoHref" @onclick="MarkShared">✉ Email</a>
                @if (_shareSupported)
                {
                    <button class="share native" @onclick="ShareLinkAsync" disabled="@_busy">📤 Share…</button>
                }
                @if (CanUndo)
                {
                    <button class="share undo" @onclick="UndoLocalMoveAsync" disabled="@_busy">↶ Undo</button>
                }
            }
        </div>
    }

    @* Shared hi-dpi canvas host (WebGl.Renderer): sizes the backing buffer to the laid-out CSS box ×
       devicePixelRatio, reports metrics, and maps pointer coords into backing space. Display size is
       whatever the flex column leaves it — see app.css for why the board wants the viewport's
       proportions rather than an aspect of its own. *@
    <div class="canvas-host">
        <WebGlCanvas @ref="_canvas" Id="board" TabIndex="0"
                     OnReady="OnCanvasReadyAsync"
                     OnResized="OnCanvasResizedAsync"
                     OnPointerDown="OnPointerDownAsync"
                     OnPointerMove="OnPointerMoveAsync"
                     OnPointerUp="OnPointerUpAsync"
                     OnKeyDown="OnKeyDownAsync" />

        @if (_unsupported is { } reason)
        {
            @* WebGL2 is the only renderer now, so its absence is a dead end rather than a
               degradation — say so plainly and say what to do about it. Silently limping along on a
               software path was the old behaviour; a blank canvas would be the worst of both. *@
            <div class="fatal" role="alert">
                <h2>This browser can't run the board</h2>
                <p>
                    Chess draws itself with <strong>WebGL2</strong>, and this browser didn't provide
                    it. Nothing is wrong with your game — there's just nothing to draw on.
                </p>
                <p>
                    Almost every browser since 2017 supports it, so the usual causes are a browser
                    old enough to predate it (<strong>iOS 14 or earlier</strong>, Internet Explorer),
                    hardware acceleration turned off, or an extension or privacy mode that blocks
                    WebGL deliberately. A current Chrome, Edge, Firefox or Safari will work.
                </p>
                <p class="detail">@reason</p>
            </div>
        }
        else if (_panel != Panel.None)
        {
            @* Focused on open so Escape closes it — the chip that opened it holds focus otherwise,
               and a modal that only a mouse can dismiss is a trap on a keyboard. *@
            <div class="panel-scrim" @onclick="ClosePanel"></div>
            <div class="panel" role="dialog" aria-modal="true" aria-label="@PanelTitle"
                 tabindex="-1" @ref="_panelRef" @onkeydown="OnPanelKeyDown">
                <div class="panel-head">
                    <strong>@PanelTitle</strong>
                    <button class="chip" @onclick="ClosePanel" aria-label="Close">✕</button>
                </div>
                <div class="panel-body">
                    @if (_panel == Panel.LinkPlay)
                    {
                        @* The discoverable "what is Play by Link?" pitch before a game, and the
                           how-do-I-send-it help mid-game — static content, so it serves both. *@
                        <p>
                            Correspondence chess with <strong>no accounts and no server</strong> —
                            the whole game travels inside the link itself. Perfect for playing
                            someone on the other side of the planet, one move at a time.
                        </p>
                        <ol>
                            <li>Choose <em>Play by Link</em> from the menu and pick your colour.</li>
                            <li>
                                Playing White? Make your move first. Playing Black? You start by
                                sending the invitation link.
                            </li>
                            <li>
                                <strong>Copy</strong>, <strong>Email</strong>, or
                                <strong>Share</strong> the link to your opponent over anything —
                                WhatsApp, Signal, iMessage, email…
                            </li>
                            <li>
                                They open it, see the board with the full move history, make their
                                move, and send the new link back. Repeat until someone wins.
                            </li>
                        </ol>
                        <p>
                            The address bar always holds the current game, so a <strong>bookmark is
                            a saved game</strong> — reopen it any time to resume. Every link is
                            replayed through the chess rules when opened: only legal games can
                            travel, and a mangled link is rejected rather than mis-played. Opening a
                            link means it's your turn — the link carries no identity, so play fair:
                            it's honour-system chess.
                        </p>
                    }
                    else
                    {
                        @* How it's built — the answer to a question only some visitors have, which is
                           exactly why it is behind a click and not in the header. *@
                        <p>
                            The full chess engine (<code>Chess.Lib</code>) compiled to WebAssembly —
                            board, rules, and the negamax AI all running
                            <em>entirely in this tab</em>. There is no back end at all: the same code
                            powers the desktop and terminal builds.
                        </p>
                        <p>
                            Every pixel is ours too: the board, the pieces and the text are drawn by
                            <code>WebGl.Renderer</code> straight to WebGL2, with the type coming from
                            a pre-baked <abbr title="multi-channel signed distance field">MSDF</abbr>
                            atlas — our own glyph rasterizer end to end, no canvas text API and no
                            font shaping in the browser.
                        </p>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    // Placeholder size, used for exactly as long as it takes WebGlCanvas to report its first
    // metrics (_backingW/_backingH = laid-out CSS box x devicePixelRatio). Nothing is drawn before
    // that arrives, and the canvas now takes whatever the flex column leaves it, so these numbers
    // are NOT a design aspect any more — the board's proportions come from the viewport.
    const int BoardW = 1280;
    const int BoardH = 800;

    // The two explainers, opened from the titlebar chips over the board. They used to be <details>
    // panels below it; there is no below any more (the app is the viewport), and putting the
    // renderer detail behind a deliberate click is the point of the exercise.
    enum Panel { None, LinkPlay, UnderTheHood }

    // The canvas shows one of three things: the startup wizard, board setup (custom game), or a
    // live game.
    enum Screen { Menu, Setup, Playing }

    Game _game = null!;

    // WebGL2 or nothing. There used to be a software RgbaImageRenderer path here (?renderer=cpu),
    // both as a fallback and as an A/B reference against the MSDF atlas; it is gone because it was
    // insurance against a population that cannot host a multi-megabyte WASM runtime anyway —
    // WebGL2 has shipped everywhere since 2017, and the browsers without it (iOS <= 14, IE) are the
    // same ones that would struggle to load the engine at all. The A/B lives on where it belongs,
    // in Chess.Tests, which renders this very display over RgbaImageRenderer with no browser at all.
    WebGlRenderer? _webGl;

    // Non-null when WebGL2 could not be obtained: the page then shows the dead-end notice instead of
    // a board, and nothing else initialises. Carries the underlying reason for the curious.
    string? _unsupported;

    // Board + history panel + captured tray + status bar — the same PixelGameDisplay the desktop GUI
    // draws. The non-generic face gives the page one reference; the display owns GameUI (created in
    // ResetGame, replaced in OnResize).
    IPixelGameDisplay _display = null!;
    GameUI Ui => _display.UI;

    WebGlCanvas _canvas = null!;
    // Backing-buffer pixel dimensions, updated from WebGlCanvas metrics. Everything renders and
    // hit-tests in this space (GameUI, menu widgets, clip rects).
    uint _backingW = BoardW;
    uint _backingH = BoardH;

    Panel _panel = Panel.None;
    ElementReference _panelRef;
    bool _focusPanel; // set on open, consumed by OnAfterRenderAsync once the element exists
    // Resolved by the canvas's first metrics report — init awaits this instead of guessing when
    // the canvas is laid out (replaces the old firstRender/_pendingPaint workaround).
    readonly TaskCompletionSource<CanvasMetrics> _canvasReady = new();

    // The startup menu reuses DIR.Lib's backend-neutral PixelMenuWidget — the same widget the
    // desktop Vulkan GUI draws.
    PixelMenuWidget<WebGlContext>? _menu;

    Screen _screen = Screen.Menu;
    // The shared wizard state machine (Chess.Lib.UI) — same flow/content as desktop + console;
    // this page only presents Current through the menu widget and forwards confirms. The web is
    // (so far) the only front-end that can produce/consume game links, so only it opts in.
    StartupWizard _wizard = new(StartupWizardOptions.LinkPlay);
    bool _vsComputer = true;
    // Side to move for a custom game, from the wizard; consumed when setup finishes.
    Side _setupSideToMove = Side.White;

    Side _humanSide = Side.White;
    Difficulty _difficulty = Difficulty.Normal;

    // The shared turn model (Chess.Lib.UI.GameSession) — the same one the desktop's GameLoop drives
    // and Chess.Droid ticks from SDL. Here it is ticked from browser events: pointer/key handlers
    // queue input into _input and AdvanceAsync runs the session until it goes idle. Built for the
    // Playing screen only; the Setup screen is a piece-placement editor with no turns to advance.
    GameSession? _session;
    readonly QueuedInputPlayer _input = new();
    bool _busy;
    bool _ready;
    string _status = "Loading…";

    // ---- Play by Link (correspondence) state. The game itself travels in the URL fragment
    // (GameLinkCodec); these fields only track this tab's role in the exchange.
    bool _linkPlay;                 // true for the whole link-game session
    Side _localSide = Side.White;   // fixed: the colour THIS tab controls (opponent is remote)
    string? _incomingFragment;      // the fragment as received — Undo re-parses it, no hand-rolled undo
    int _incomingPlyCount;          // plies when the link was opened; > means a local move is staged
    string? _lastAppliedFragment;   // dedupes our own replaceState echo against LocationChanged
    bool _linkCopied;               // transient "Copied ✓" button label
    bool _linkShared;               // flips the status from "send the link" to "waiting for reply"
    bool _shareSupported;           // navigator.share feature detection (once, at boot)
    string? _linkError;             // last Invalid-link message from TryApplyFragmentAsync

    // Must match PixelGameDisplay's internal background — the display's GameUI paints margins
    // with it, and the host clears the rest of the surface; a mismatch would band.
    static readonly RGBAColor32 Background = PixelGameDisplay<WebGlContext>.Background;

    static string SdfCacheDir => System.IO.Path.Combine(AppContext.BaseDirectory, "sdfcache");

    protected override async Task OnInitializedAsync()
    {
        await LoadFontsAsync();

        // The canvas's first metrics report tells us the real backing size (CSS box x dpr) —
        // and doubles as the "canvas is in the DOM and laid out" gate that renderer init needs.
        var metrics = await _canvasReady.Task;
        _backingW = metrics.BackingWidth;
        _backingH = metrics.BackingHeight;

        try
        {
            await LoadSdfCacheAsync(); // best-effort; a miss only costs runtime rasterization
            // readOnly: single-threaded WASM has no writer thread; the pre-baked cache is
            // load-only. Raster size/spread must match the bake (the shared atlas constants).
            _webGl = await WebGlRenderer.CreateAsync("board", _backingW, _backingH,
                diskCache: new SdfGlyphDiskCache(SdfCacheDir,
                    SdfFontAtlas.SdfRasterSize, SdfFontAtlas.SdfSpread, readOnly: true));
            // Pull the pre-baked glyphs into the atlas NOW, while "Loading…" shows —
            // otherwise the first frame rasterizes every visible glyph inline (seconds on
            // an interpreted WASM host).
            _status = "Preparing glyphs…";
            StateHasChanged();
            _webGl.PrimeFonts(FontPaths.Merida, FontPaths.DejaVuSans);
            Console.WriteLine($"[chess-web] webgl ready — atlas: {_webGl.Atlas.FrameStats}");
        }
        catch (Exception ex)
        {
            // No WebGL2 (or the interop module failed to load) — there is no second renderer to fall
            // back to, so stop here and say why. _ready stays false, which keeps every input handler
            // shut; the notice replaces the board.
            Console.Error.WriteLine($"[chess-web] WebGL init failed: {ex}");
            _unsupported = ex.Message;
            _status = "This browser doesn't support WebGL2.";
            return;
        }

        _menu = new PixelMenuWidget<WebGlContext>(_webGl, FontPaths.DejaVuSans);
        _display = new PixelGameDisplay<WebGlContext>(_webGl);

        _ready = true;
        _shareSupported = await JS.InvokeAsync<bool>("chessCanvas.isShareSupported");

        // A game link in the fragment skips the wizard entirely: the link means "it's your
        // turn" — decode, replay, and put the board straight on screen.
        var bootFragment = new Uri(Nav.Uri).Fragment;
        if (await TryApplyFragmentAsync(bootFragment))
        {
            _incomingFragment = bootFragment;
            await PersistFragmentAsync(); // canonicalize the address bar (also seeds the dedupe)
        }
        else
        {
            ShowWizardStep();
            if (_linkError is { } err)
                _status = err; // don't let the wizard's default text swallow a broken-link error
            await RenderMenuAsync(); // canvas + renderer are guaranteed live here — paint directly
        }

        // A second link pasted into this same tab is a fragment-only navigation — Blazor raises
        // LocationChanged without reloading the app, and we apply it like a fresh open.
        Nav.LocationChanged += OnLocationChanged;
    }

    Task OnCanvasReadyAsync(CanvasMetrics metrics)
    {
        _canvasReady.TrySetResult(metrics);
        return Task.CompletedTask;
    }

    // Window resize / reflow / devicePixelRatio change: resize the live renderer + UI in place
    // and repaint whatever screen is showing. The menu widget tracks the renderer's size on its
    // own; only GameUI bakes pixel sizes in at construction (Resize returns a NEW instance).
    async Task OnCanvasResizedAsync(CanvasMetrics metrics)
    {
        if (!_ready) return; // pre-init reports are consumed via _canvasReady

        _backingW = metrics.BackingWidth;
        _backingH = metrics.BackingHeight;

        _webGl!.Resize(_backingW, _backingH);

        // Recomputes the board/history/status split and rebuilds GameUI at the new size
        // (state-preserving); a no-op until the first ResetGame.
        _display.OnResize((int)_backingW, (int)_backingH);

        if (_screen == Screen.Menu)
            await RenderMenuAsync();
        else
            await RenderBoardAsync();
    }

    // .NET's WASM runtime has a working in-memory filesystem, and GameUI resolves
    // fonts as AppContext.BaseDirectory/Fonts/*.ttf. Fetch the bytes from wwwroot
    // and drop them at that exact path so the managed rasterizer's LoadFromFile
    // finds them — no library change needed.
    async Task LoadFontsAsync()
    {
        var dir = FontPaths.FontsDirectory;
        System.IO.Directory.CreateDirectory(dir);
        foreach (var name in new[] { "DejaVuSans.ttf", "Merida.ttf" })
        {
            var dest = System.IO.Path.Combine(dir, name);
            if (!System.IO.File.Exists(dest))
            {
                var bytes = await Http.GetByteArrayAsync($"Fonts/{name}");
                await System.IO.File.WriteAllBytesAsync(dest, bytes);
            }
        }
    }

    // Same trick for the pre-baked MSDF atlas: fetch each .sdfg (content-hash names come from
    // manifest.txt, one per line) into the in-memory FS dir the read-only SdfGlyphDiskCache
    // points at. Missing cache (e.g. a dev run without a bake) is fine — glyphs rasterize
    // inline on first use instead; only startup speed differs.
    async Task LoadSdfCacheAsync()
    {
        // Fully best-effort: any miss (no bake in a dev run, a blocked fetch, …) must degrade to
        // runtime rasterization, never take down the WebGL path itself.
        try
        {
            var manifest = await Http.GetStringAsync("sdfcache/manifest.txt");
            System.IO.Directory.CreateDirectory(SdfCacheDir);
            var loaded = 0;
            foreach (var line in manifest.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                // Files ship as {hash}.sdfg.bin (static hosts need a known MIME extension);
                // SdfGlyphDiskCache expects {hash}.sdfg on disk, so strip the suffix here.
                var destName = line.EndsWith(".bin", StringComparison.Ordinal) ? line[..^4] : line;
                var dest = System.IO.Path.Combine(SdfCacheDir, destName);
                if (!System.IO.File.Exists(dest))
                {
                    var bytes = await Http.GetByteArrayAsync($"sdfcache/{line}");
                    await System.IO.File.WriteAllBytesAsync(dest, bytes);
                }
                loaded++;
            }
            Console.WriteLine($"[chess-web] sdf cache: {loaded} file(s) staged");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[chess-web] no pre-baked sdf cache ({ex.Message}) — rasterizing at runtime");
        }
    }

    // ---- startup wizard -------------------------------------------------------------------------

    // Loads the wizard's current step into the menu widget (Reset also clears its confirmed flag).
    void ShowWizardStep()
    {
        var (title, prompt, items) = _wizard.Current;
        _menu?.Reset(title, prompt, [..items]);
        _status = "Choose how you'd like to play.";
    }

    // A click in menu mode: dispatch to the widget (a hit both selects and confirms the item),
    // then advance the wizard or start the game. Coords arrive pre-mapped to backing space.
    async Task HandleMenuClickAsync(CanvasPointerEventArgs e)
    {
        var confirmed = DispatchMenu(new InputEvent.MouseDown(e.X, e.Y));
        if (confirmed is { } sel)
            await ConfirmWizardAsync(sel);
        // A click that misses every item confirms nothing and changes nothing — no redraw needed.
    }

    // Keyboard: in the menu, arrows move the highlight and Enter/digits confirm; in a game the
    // keys route to GameUI.HandleKeyDown — the desktop bindings (a–h/1–8 square entry, promotion
    // letters, Ctrl+arrows / Esc playback, setup piece keys + s to start).
    async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (!_ready || _busy) return;

        if (_screen == Screen.Menu)
        {
            // Same key map as gameplay: MenuModel consumes arrows/Enter/digits, ignores the rest.
            if (MapGameKey(e.Key) is not { } key) return;

            var confirmed = DispatchMenu(new InputEvent.KeyDown(key));
            if (confirmed is { } sel)
                await ConfirmWizardAsync(sel);
            else
                await RenderMenuAsync(); // selection moved — repaint the highlight
            return;
        }

        if (MapGameKey(e.Key) is not { } gameKey) return;
        var modifiers = e.CtrlKey ? InputModifier.Ctrl : InputModifier.None;

        // Setup and play both go through the session now: it applies the key and anything that follows
        // from it — 's' lowering GameUI's setup flag and the transition into a real game, or a
        // keyboard-entered move handing the turn to the AI.
        _input.PressKey(gameKey, modifiers);
        await AdvanceAsync();
    }

    // Maps browser KeyboardEvent.key values to the DIR.Lib keys GameUI binds (desktop keymap).
    // Tab (browser focus nav) and F-keys (browser chrome) deliberately stay unmapped — their
    // GameUI actions have on-page buttons instead.
    static InputKey? MapGameKey(string key) => key switch
    {
        "ArrowUp" => InputKey.Up,
        "ArrowDown" => InputKey.Down,
        "ArrowLeft" => InputKey.Left,
        "ArrowRight" => InputKey.Right,
        "Escape" => InputKey.Escape,
        "Enter" => InputKey.Enter,
        "Delete" => InputKey.Delete,
        "Backspace" => InputKey.Backspace,
        "PageUp" => InputKey.PageUp,
        "PageDown" => InputKey.PageDown,
        [var c] when char.IsAsciiLetter(c) => InputKey.A + (char.ToLowerInvariant(c) - 'a'),
        [var c] when char.IsAsciiDigit(c) => InputKey.D0 + (c - '0'),
        _ => null,
    };

    // Dispatches an event to the menu widget; returns the confirmed index, else null.
    // (A hit/Enter/digit both selects and confirms; an arrow only moves the selection.)
    int? DispatchMenu(InputEvent ev)
    {
        _menu!.HandleInput(ev);
        return _menu.IsConfirmed ? _menu.SelectedIndex : null;
    }

    // Feeds a confirmed item into the shared wizard: either advance to the next step, or map the
    // finished Result onto this page's state and start the chosen game.
    async Task ConfirmWizardAsync(int selected)
    {
        _wizard.Confirm(selected);
        if (!_wizard.IsComplete)
        {
            ShowWizardStep();
            await RenderMenuAsync();
            return;
        }

        var (mode, computerSide, sideToMove, difficulty) = _wizard.Result;
        _difficulty = difficulty;

        if (mode == GameMode.PlayByLink)
        {
            // "computerSide" carries the side NOT locally controlled — here the remote
            // correspondent (see StartupWizard.Result docs). No AI is ever involved.
            _vsComputer = false;
            _linkPlay = true;
            _localSide = computerSide == Side.White ? Side.Black : Side.White;
            await StartPlayingAsync();
            return;
        }

        _vsComputer = computerSide != Side.None;
        _humanSide = computerSide == Side.White ? Side.Black : Side.White;
        _setupSideToMove = sideToMove;

        if (mode is GameMode.CustomGameEmpty or GameMode.CustomGameStandardBoard)
            await EnterSetupAsync(emptyBoard: mode == GameMode.CustomGameEmpty);
        else
            await StartPlayingAsync();
    }

    // Maps a browser KeyboardEvent.key to the menu-relevant DIR.Lib keys (MenuModel handles the
    // rest: Up/Down wrap, Enter confirms, D1/D2 select-and-confirm). Returns null to ignore.

    async Task StartPlayingAsync()
    {
        _screen = Screen.Playing;
        StartNewGame();
        // Auto-orient to the local player's side (their pieces at the bottom): the correspondent's
        // side in link play, the human's vs the AI. PvP leaves _humanSide = White, so no flip.
        Ui.FlipBoard = (_linkPlay ? _localSide : _humanSide) == Side.Black;
        if (_linkPlay)
        {
            // After ResetGame (which builds the fresh GameUI): one-local-move gate. Creator as
            // White moves first then shares; as Black the empty-game link IS the invitation.
            Ui.MoveLockSide = _localSide;
            _incomingFragment = GameLinkCodec.EncodeFragment(_game);
            _incomingPlyCount = 0;
            RefreshStatus();
        }
        await RenderBoardAsync();
        if (_linkPlay)
            await PersistFragmentAsync();
        await AdvanceAsync(); // if the human chose Black, White (the AI) opens
    }

    async Task BackToMenuAsync()
    {
        _busy = false;
        _display.StatusOverride = null;
        if (_linkPlay)
        {
            // Leaving a link game: scrub the fragment so the address bar doesn't keep offering
            // a stale game, and drop the session state.
            _linkPlay = false;
            _lastAppliedFragment = null;
            _linkShared = false;
            await JS.InvokeVoidAsync("chessCanvas.replaceStateFragment", "");
        }
        _screen = Screen.Menu;
        _wizard = new StartupWizard(StartupWizardOptions.LinkPlay);
        ShowWizardStep();
        await RenderMenuAsync();
    }

    // ---- custom game: board setup ---------------------------------------------------------------

    // Opens GameUI's setup mode on an empty or standard board. All placement — picking a piece up,
    // dropping it, choosing a type from the on-board palette, toggling the placement colour — is
    // handled by GameUI via the normal pointer routing; the display's status bar shows the hints.
    async Task EnterSetupAsync(bool emptyBoard)
    {
        _screen = Screen.Setup;
        _game = emptyBoard ? new Game(new Board(), _setupSideToMove, []) : new Game();
        BeginSession(inSetup: true); // resets the display and opens GameUI's setup mode
        _busy = false;
        RefreshSetupStatus();
        await RenderBoardAsync();
    }

    private const string SetupHint =
        "Set up the board: drag a piece to move it, or click it and then its new square. "
        + "An empty square opens the piece picker; the swatch toggles colour; Start begins the game.";

    /// <summary>
    /// Setup's status is LIVE rather than a banner set once on entry. With a piece in hand the
    /// canonical <see cref="GameUI.StatusLine"/> names it, and on this front-end that sentence is
    /// the ONLY words-level feedback that a click picked something up instead of doing nothing —
    /// the desktop and terminal both show it in the in-canvas status bar, which the browser layout
    /// gives far less room to.
    /// </summary>
    void RefreshSetupStatus() => _status = Ui.PickedUp is not null ? Ui.StatusLine() : SetupHint;

    // The "▶ Start game" button. Only lowers GameUI's setup flag — freezing the arranged board into a
    // real game is the session's setup transition, which AdvanceAsync picks up as SetupFinished. The
    // 's' key reaches the same place by going through GameUI itself.
    async Task FinishSetupAsync()
    {
        if (_screen != Screen.Setup) return;
        Ui.CancelPlacement(); // a picker left open would keep its scrim over the live board
        Ui.IsSetupMode = false;
        await AdvanceAsync();
    }

    // ---- gameplay -------------------------------------------------------------------------------

    void StartNewGame()
    {
        _game = new Game();
        BeginSession();
        _busy = false;
        RefreshStatus();
    }

    // Wraps the current _game in a session for the Playing screen. GameSession.Create resets the
    // display (building GameUI at the board area, total − chrome), so anything the caller sets on the
    // UI — FlipBoard, MoveLockSide — belongs AFTER this call, not before.
    /// <param name="inSetup">Open in the session's setup phase. The side to move then comes from the
    /// wizard rather than the half-built board, because the session uses it to freeze the arranged
    /// position into a real game when setup ends.</param>
    void BeginSession(bool inSetup = false)
    {
        var computerSide = _vsComputer ? (_humanSide == Side.White ? Side.Black : Side.White) : Side.None;

        _session = GameSession.Create(
            _display,
            inSetup
                ? GameMode.CustomGameStandardBoard
                : _vsComputer ? GameMode.PlayerVsComputer : GameMode.PlayerVsPlayer,
            computerSide,
            inSetup ? _setupSideToMove : _game.CurrentSide,
            () => _input,
            _vsComputer ? (side, _) => new LocalEnginePlayer(side, _difficulty) : null,
            resumeGame: _game,
            beginInSetup: inSetup);

        // A session still placing pieces has no opponent to bring up yet — the engine's opening
        // position is the board being built. AdvanceAsync starts it when Tick reports SetupFinished.
        if (!inSetup)
        {
            _session.Start(TimeProvider.System);
        }
    }

    // Runs the session until it has nothing left to do, painting between plies.
    //
    // The pre-paint is the whole reason Tick advances only one ply: the in-process search blocks the
    // single WASM thread, so "thinking…" has to reach the screen BEFORE it starts. IsEngineTurn is
    // what says a blocking call is next; once Tick has been entered it is far too late to repaint.
    async Task AdvanceAsync()
    {
        if (_session is null) return;

        var restart = false;

        try
        {
            for (var guard = 0; guard < 64; guard++)
            {
                if (_session.IsEngineTurn)
                {
                    // _busy gates input, and it means exactly "a search is blocking the thread" — not
                    // "a turn is being advanced". Setting it for every call would swallow keystrokes
                    // in link play, where there is no engine and nothing ever blocks.
                    _busy = true;
                    _status = $"{_game.CurrentSide} (AI) thinking…";
                    _display.StatusOverride = _status;
                    StateHasChanged();
                    await RenderBoardAsync();
                    await Task.Delay(20); // let the frame actually reach the screen
                }

                var tick = _session.Tick();

                if (tick.Outcome is SessionOutcome.Idle)
                {
                    break;
                }

                if (tick.Outcome is SessionOutcome.NeedsRestart)
                {
                    restart = true;
                    break;
                }

                if (tick.Outcome is SessionOutcome.SetupFinished)
                {
                    // The session froze the arranged board into a real game — pick up the new
                    // instance, bring the opponent up against it, and switch screens.
                    _game = _session.Game;
                    _session.Start(TimeProvider.System);
                    Ui.FlipBoard = _humanSide == Side.Black; // custom game vs the AI as Black -> flip
                    _screen = Screen.Playing;
                    _status = string.Empty;
                    RefreshStatus();
                    await RenderBoardAsync();
                    StateHasChanged();
                    continue;
                }

                _display.StatusOverride = null;

                // PlyCommitted, not IsUpdate: playback navigation reports an update too, and a link
                // must not be rewritten because someone scrubbed back through the history.
                if (tick.PlyCommitted && _linkPlay)
                {
                    await PersistFragmentAsync();
                }

                // While placing pieces the status line is the setup instructions, not the side to
                // move — refreshing it there would replace the only hint telling you what to do.
                if (_session.IsSetupMode)
                {
                    RefreshSetupStatus();
                }
                else
                {
                    RefreshStatus();
                }

                await RenderBoardAsync();
            }
        }
        finally
        {
            _busy = false;
            _display.StatusOverride = null;
        }

        if (restart)
        {
            await BackToMenuAsync();
            return;
        }

        if (!_session.IsSetupMode)
        {
            RefreshStatus();
        }

        StateHasChanged();
    }

    async Task OnPointerDownAsync(CanvasPointerEventArgs e)
    {
        if (!_ready || _busy) return;

        if (_screen == Screen.Menu)
        {
            await HandleMenuClickAsync(e);
            return;
        }

        if (_screen == Screen.Setup)
        {
            // Placement/selection/colour-toggle goes through the session's setup phase, same as every
            // other front-end. Setup never auto-finishes; only the Start button or 's' ends it.
            _input.PressPointer(e.X, e.Y);
            await AdvanceAsync();
            return;
        }

        // No IsFinished gate: after mate the history panel stays clickable (playback review),
        // exactly like the desktop; GameUI/Game reject board moves on a finished game. The session
        // applies the tap and everything that follows — the reply, the link handoff, the repaints.
        _input.PressPointer(e.X, e.Y);
        await AdvanceAsync();
    }

    /// <summary>
    /// Carries the setup drag ghost under the pointer. Deliberately NOT through
    /// <c>_input</c>/<c>AdvanceAsync</c> like the press and the release either side of it: a session
    /// tick per pointer position is the wrong shape for a stream that arrives once per pixel of
    /// travel, and there is no turn to advance — the ghost is a render hint, and the model still has
    /// the piece on its origin square until the release lands it.
    ///
    /// <para><c>HandleDragPointer</c> answers false whenever nothing is in hand, so a plain hover
    /// costs one call and no frame. When it does claim the event, the frame has to be asked for
    /// right here: Chess.Web is the one host with no idle hook — it renders on demand from Blazor
    /// handlers, where the SDL hosts would just return true and let their redraw poll notice.</para>
    /// </summary>
    async Task OnPointerMoveAsync(CanvasPointerEventArgs e)
    {
        if (!_ready || _busy || _screen != Screen.Setup) return;
        if (!_display.HandleDragPointer(new InputEvent.MouseMove(e.X, e.Y))) return;

        await RenderBoardAsync();
    }

    /// <summary>
    /// Ends a setup drag: press a piece, release over another square, and it lands there. Setup
    /// only — GameUI.HandlePointerUp is inert with nothing in hand, but there is no reason to spend
    /// a tick finding that out on every click of a game. WebGlCanvas delivers this for a lifted
    /// finger as well as a released mouse button, and for pointercancel/leave, so a drag that ends
    /// off the canvas resolves as a release nowhere near a square — which leaves the piece in hand
    /// rather than dropping it somewhere the player never pointed at.
    /// </summary>
    async Task OnPointerUpAsync(CanvasPointerEventArgs e)
    {
        if (!_ready || _busy || _screen != Screen.Setup) return;

        _input.ReleasePointer(e.X, e.Y);
        await AdvanceAsync();
    }

    // ---- rendering ------------------------------------------------------------------------------

    async Task RenderMenuAsync()
    {
        _webGl!.Clear(Background);
        _menu!.Render();
        _webGl.Present(); // synchronous [JSImport] flush — one interop call per frame

        // Focus the canvas (so arrow/Enter reach it without a click first) and suppress the
        // page-scroll default for those keys while the menu is up.
        await JS.InvokeVoidAsync("chessCanvas.enableMenuKeys", "board", true);
    }

    // One frame of the game screen: the display draws board + history panel + captured tray + status
    // bar (and rebuilds its click regions — history hit-testing needs the fresh frame).
    Task RenderBoardAsync()
    {
        _webGl!.Clear(Background);
        _display.Render();
        _webGl.Present(); // synchronous [JSImport] flush — one interop call per frame
        return Task.CompletedTask;
    }

    // The field is what the NEXT game starts at; the session is the game already in progress. Setting
    // only the field is a silent no-op mid-game — the dropdown moves and the engine carries on at the
    // old depth — because the session builds its opponent once, from whatever the field held then.
    void OnDifficultyChanged(ChangeEventArgs e)
    {
        if (!Enum.TryParse<Difficulty>((string?)e.Value, out var level)) return;

        _difficulty = level;
        if (_session is not null) _session.Difficulty = level;
    }

    // ---- help panels ----------------------------------------------------------------------------

    // Clicking the open panel's own chip closes it, so a chip is a toggle rather than a trap.
    void TogglePanel(Panel panel)
    {
        _panel = _panel == panel ? Panel.None : panel;
        _focusPanel = _panel != Panel.None;
    }

    void ClosePanel() => _panel = Panel.None;

    string PanelTitle => _panel == Panel.LinkPlay ? "How \"Play by Link\" works" : "Under the hood";

    void OnPanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ClosePanel();
    }

    // The panel takes focus when it opens: the chip that opened it holds focus otherwise, so Escape
    // would go nowhere and the only way out would be the mouse. Refocusing the canvas on close is
    // left to the click/keystroke that follows — grabbing it back here would fight a Tab away.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPanel) return;
        _focusPanel = false;
        await _panelRef.FocusAsync();
    }

    // ---- status ---------------------------------------------------------------------------------

    // Keeps the sr-only aria-live paragraph and the in-canvas status bar in lockstep. Link play
    // overrides the display's derived text with its own handoff phrases; every other mode keeps
    // GameUI's derived status bar (Override = null).
    void RefreshStatus()
    {
        _status = StatusText();
        _display.StatusOverride = _linkPlay ? _status : null;
    }

    string StatusText() => _linkPlay ? LinkPlayStatusText() : PlainStatusText();

    string PlainStatusText()
        => _game.GameStatus.ToMessage(_game.IsFinished ? _game.Winner : _game.CurrentSide);

    string LinkPlayStatusText()
    {
        if (_game.IsFinished)
            return PlainStatusText();
        if (_game.CurrentSide == _localSide)
            return $"Your move ({_localSide}) — make it, then send the link.";
        if (_linkShared)
            return $"Waiting for {_localSide.ToOpposite()}'s reply link…";
        return _game.PlyCount == 0
            ? "Send the link to your opponent — they open it and play White."
            : "Move staged — copy, email, or share the link now.";
    }

    // ---- Play by Link: fragment plumbing --------------------------------------------------------

    // The single writer of the address bar: encodes the live game and replaceState's it in, so a
    // bookmark (or a copy of the URL) is always the current game. Also re-arms the "not yet
    // shared" state whenever the position actually changed.
    async Task PersistFragmentAsync()
    {
        var fragment = GameLinkCodec.EncodeFragment(_game);
        if (fragment == _lastAppliedFragment) return;
        _lastAppliedFragment = fragment;
        _linkShared = false;
        _linkCopied = false;
        await JS.InvokeVoidAsync("chessCanvas.replaceStateFragment", fragment);
    }

    // Shared by boot, same-tab link navigation, and Undo: decode + replay a fragment and, if it
    // holds a game, put it on screen as a link-play session. "Receiving a link means it's your
    // turn": the local side is whatever side is to move in the decoded position.
    async Task<bool> TryApplyFragmentAsync(string fragment)
    {
        var result = GameLinkCodec.TryDecode(fragment, out var game, out var error);
        if (result == GameLinkResult.NoLink)
        {
            _linkError = null;
            return false;
        }
        if (result == GameLinkResult.Invalid)
        {
            _linkError = $"That link isn't a valid chess game ({error}).";
            _status = _linkError;
            return false;
        }

        _game = game!;
        _vsComputer = false;
        BeginSession(); // resets the display, so the UI settings below must follow it
        _linkPlay = true;
        _linkError = null;
        _linkShared = false;
        _localSide = _game.CurrentSide;
        Ui.MoveLockSide = _localSide;
        Ui.FlipBoard = _localSide == Side.Black; // orient to the receiving player's side
        _incomingPlyCount = _game.PlyCount;
        _screen = Screen.Playing;
        _busy = false;
        RefreshStatus();
        await RenderBoardAsync();
        return true;
    }

    // Fragment-only navigation (opponent's next link pasted into this same tab) raises
    // LocationChanged without reloading the WASM app — apply it like a fresh open. The
    // _lastAppliedFragment guard swallows echoes of our own replaceState. An invalid link
    // mid-session only sets the status; it never tears down the running game.
    async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            if (!_ready || _busy) return;
            var fragment = new Uri(e.Location).Fragment;
            if (fragment == _lastAppliedFragment) return;

            await InvokeAsync(async () =>
            {
                if (await TryApplyFragmentAsync(fragment))
                {
                    _incomingFragment = fragment;
                    await PersistFragmentAsync();
                }
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[chess-web] LocationChanged handling failed: {ex}");
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    // ---- Play by Link: share row ----------------------------------------------------------------

    // The handoff affordances appear once the local move is staged (or the game just ended and
    // the final link still needs sending). While it's genuinely your turn there's nothing to
    // share yet — the row appearing IS the "now send it" cue.
    bool ShowShareRow => _linkPlay && (_game.IsFinished || _game.CurrentSide != _localSide);

    // Undo is only offered while the staged local move hasn't notionally left this tab — it
    // re-parses the fragment as received, so even a move that just ended the game (a misclick
    // into stalemate) can be taken back before sending.
    bool CanUndo => _linkPlay && _incomingFragment is not null && _game.PlyCount > _incomingPlyCount;

    string GameUrl => Nav.BaseUri + GameLinkCodec.EncodeFragment(_game); // BaseUri ends in '/'

    // The entire body (URL included) is percent-encoded: '#' and '&' inside a mailto body value
    // would otherwise truncate the link in most mail clients.
    string MailtoHref
    {
        get
        {
            var subject = Uri.EscapeDataString("Your move! ♟ (chess by link)");
            var body = Uri.EscapeDataString(
                $"It's your move — open this link to see the board and reply with yours:\n\n{GameUrl}");
            return $"mailto:?subject={subject}&body={body}";
        }
    }

    async Task CopyLinkAsync()
    {
        var ok = await JS.InvokeAsync<bool>("chessCanvas.copyText", GameUrl);
        _linkCopied = ok;
        if (ok) _linkShared = true;
        RefreshStatus();
        StateHasChanged();
        if (ok) _ = ResetCopiedLabelAfterDelayAsync();
    }

    async Task ResetCopiedLabelAfterDelayAsync()
    {
        await Task.Delay(1500);
        _linkCopied = false;
        await InvokeAsync(StateHasChanged);
    }

    async Task ShareLinkAsync()
    {
        var ok = await JS.InvokeAsync<bool>("chessCanvas.shareLink", GameUrl,
            "Chess — your move", "It's your move! Open the link to play:");
        if (ok)
        {
            _linkShared = true;
            RefreshStatus();
            StateHasChanged();
        }
    }

    // Optimistic — fired from the mailto anchor's onclick; we can't observe the mail client.
    void MarkShared()
    {
        _linkShared = true;
        RefreshStatus();
    }

    async Task UndoLocalMoveAsync()
    {
        if (await TryApplyFragmentAsync(_incomingFragment!))
            await PersistFragmentAsync();
        StateHasChanged();
    }
}
