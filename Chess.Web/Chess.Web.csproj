<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The browser app is a consumer of Chess.Lib and not a shipped artifact, but it IS in
         Chess.sln and IS under the repo's Central Package Management (every version lives in
         Directory.Packages.props). It used to be outside both, on the reasoning that it is not
         part of the test/desktop-release chain. That cost more than it saved: `dotnet restore
         Chess.sln` silently skipped it, so a UseLocalSiblings=false verification covered 8 of 9
         projects, and the WebGl.Renderer pin sat here where no solution-wide sweep could see it. -->
    <IsPackable>false</IsPackable>
    <!-- A chess board doesn't need culture data; dropping ICU trims the payload. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Chess.Lib + the DIR.Lib managed rasterizer reach glyph/table data structurally;
         keep trimming conservative and root the assemblies below so nothing needed is cut. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chess.Lib\Chess.Lib.csproj" />
    <!-- For UciMove + GameLinkCodec only (Play by Link). NOT a TrimmerRootAssembly: the
         Process-based UciClient/UciPlayer must stay trimmable — nothing browser-side can
         launch an engine process. -->
    <ProjectReference Include="..\Chess.UCI\Chess.UCI.csproj" />
  </ItemGroup>

  <!-- WebGL backend: sibling working copy for local iteration, NuGet in CI — the same switch as
       every other sibling reference, and now the same place for the version too (the pin is
       WebGl.Renderer in Directory.Packages.props, not an inline attribute here). -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\WebGl.Renderer\src\WebGl.Renderer\WebGl.Renderer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="WebGl.Renderer" />
  </ItemGroup>

  <!-- The pure-managed render stack (board logic, DIR.Lib RgbaImageRenderer,
       ManagedFontRasterizer, SharpAstro.Fonts OpenType/MSDF tables) is reached
       structurally / via font-file parsing the trimmer can't follow. Root them. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Chess.Lib" />
    <TrimmerRootAssembly Include="DIR.Lib" />
    <TrimmerRootAssembly Include="SharpAstro.Fonts" />
    <TrimmerRootAssembly Include="WebGl.Renderer" />
  </ItemGroup>

</Project>
